<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-browserwasm;net10.0-desktop</TargetFrameworks>
    <TargetFrameworks Condition="'$(GitSpaceTargetFrameworks)' != ''">$(GitSpaceTargetFrameworks)</TargetFrameworks>
    <UnoSingleProject>true</UnoSingleProject><UnoFeatures>SkiaRenderer</UnoFeatures><OutputType>Library</OutputType>
    <IsPackable>true</IsPackable><GenerateLibraryLayout>true</GenerateLibraryLayout>
    <Description>Embeddable Git client workbench composed of reusable Uno controls and an injected repository backend.</Description>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../GitSpace.Controls.Uno/GitSpace.Controls.Uno.csproj" /><ProjectReference Include="../GitSpace.Hosting.GitHub/GitSpace.Hosting.GitHub.csproj" /></ItemGroup>
</Project>
