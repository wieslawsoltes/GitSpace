{
  "name": "@gitspace/browser-git",
  "version": "0.1.0",
  "description": "Worker-ready real Git repositories for browser storage, with guarded GitSpace command contracts",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./backend.mjs",
    "./worker": "./dist/worker.js"
  },
  "files": [
    "backend.mjs",
    "worker.mjs",
    "buffer-shim.mjs",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "esbuild worker.mjs --bundle --format=esm --platform=browser --target=es2022 --inject:./buffer-shim.mjs --outfile=dist/worker.js",
    "test": "node --test ../../tests/browser/backend.test.mjs"
  },
  "dependencies": {
    "@isomorphic-git/lightning-fs": "4.6.0",
    "buffer": "6.0.3",
    "fflate": "0.8.2",
    "isomorphic-git": "1.33.1"
  },
  "devDependencies": {
    "esbuild": "0.25.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wieslawsoltes/GitSpace.git",
    "directory": "src/GitSpace.BrowserGit"
  }
}
